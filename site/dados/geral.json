{"meta":{"gerado_em":"2026-11-16","inicio":"2025-01-01","ultima_sessao_com_lista":"2026-11-11","total_sessoes_com_lista":163,"sessoes_nao_solenes":170,"total_votacoes_desde_inicio":4525,"total_votacoes_nominais":411,"materias_baixadas":30721,"grupos":[{"nome":"Pedidos de melhoria","desc":"Pedem obras e serviços ao prefeito: tapar buraco, podar árvore, limpar praça, instalar iluminação. Quase todos citam uma rua ou bairro."},{"nome":"Perguntas e cobranças","desc":"Pedem informações ao governo ou chamam um secretário à Câmara para explicar."},{"nome":"Homenagens","desc":"Parabéns, pêsames, título de cidadão, medalhas, nome de rua ou praça e datas comemorativas."},{"nome":"Propostas de lei","desc":"Projetos para criar ou mudar leis, decretos e regras da Câmara."},{"nome":"Outros","desc":"Tudo o que não cabe nos grupos acima: protestos e apoios (moções), pedidos internos da Câmara, mudanças em projetos (emendas)."}],"regras":[{"g":2,"t":"Texto oficial começa com “Concede” (título, medalha, diploma)."},{"g":2,"t":"Texto oficial pede voto de aplauso, congratulação ou pesar."},{"g":2,"t":"Texto oficial dá nome a rua, praça ou prédio (“Denomina…”)."},{"g":2,"t":"Projeto de lei que cria um dia, semana ou evento no calendário oficial."},{"g":2,"t":"Pede reunião solene (ou entrega direta) de título, diploma ou honraria."},{"g":1,"t":"Requerimento ou pedido que começa pedindo informações ou esclarecimentos."},{"g":1,"t":"Pede a convocação de um secretário para explicar algo à Câmara."},{"g":0,"t":"É uma Indicação: pedido de obra ou serviço ao prefeito."},{"g":3,"t":"É um projeto de lei, de lei complementar, de decreto legislativo, de resolução ou mudança da Lei Orgânica."},{"g":4,"t":"Não se encaixa em nenhuma regra acima."}],"api":"https://sapl.campinas.sp.leg.br/api"},"vereadores":[{"id":311,"nome":"Ailton da Farmácia","nome_completo":"Ailton Fernandes Sarmento","partido":"PSB","ativo":true,"foto":"https://sapl.campinas.sp.leg.br/media/sapl/public/parlamentar/311/54628460351_